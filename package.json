{
  "name": "socicon",
  "version": "3.10.0",
  "description": "More information on [socicon website](http://socicon.teddypayet.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ybbet/socicon.git"
  },
  "bugs": {
    "url": "https://github.com/Ybbet/socicon/issues"
  },
  "homepage": "https://github.com/Ybbet/socicon#readme",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run generate && npm run site:data && npm run check",
    "check": "node scripts/check.mjs",
    "clean": "node scripts/clean.mjs",
    "generate": "node scripts/generate.mjs",
    "metadata:apply": "node scripts/metadata-apply.mjs",
    "metadata:audit": "node scripts/metadata-audit.mjs",
    "metadata:bootstrap": "node scripts/metadata-bootstrap.mjs",
    "metadata:enrich": "node scripts/metadata-enrich.mjs",
    "metadata:update": "node scripts/metadata-update.mjs",
    "rebuild": "npm run clean && npm run build",
    "release:build": "bash scripts/release-build.sh",
    "site:data": "node scripts/site-data.mjs"
  },
  "devDependencies": {
    "svgpath": "^2.6.0"
  }
}
