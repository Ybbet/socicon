{
  "name": "socicon",
  "description": "More information on [socicon website](http://socicon.teddypayet.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ybbet/socicon.git"
  },
  "bugs": {
    "url": "https://github.com/Ybbet/socicon/issues"
  },
  "homepage": "https://github.com/Ybbet/socicon#readme",
  "private": true,
  "type": "module",
  "scripts": {
    "metadata:bootstrap": "node scripts/bootstrap-metadata.mjs",
    "metadata:audit": "node scripts/audit-metadata.mjs",
    "metadata:update": "node scripts/update-metadata.mjs",
    "generate": "node scripts/generate-assets.mjs",
